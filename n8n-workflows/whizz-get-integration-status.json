        "jsCode": "// ── Only ever return a connected/not-connected flag plus non-secret fields ──\n// The frontend must never see a stored apiKey or appPassword again after it's saved.\nconst rows = $input.all();\n\nfunction findService(name) {\n  const row = rows.find(r => (r.json.service || '').toLowerCase() === name);\n  if (!row) return null;\n  try {\n    return JSON.parse(row.json.data || '{}');\n  } catch (e) {\n    return null;\n  }\n}\n\nconst brevo = findService('brevo');\nconst wordpress = findService('wordpress');\n\nreturn [{\n  json: {\n    brevo: {\n      connected: !!(brevo && brevo.apiKey),\n      listId: (brevo && brevo.listId) || ''\n    },\n    wordpress: {\n      connected: !!(wordpress && wordpress.siteUrl && wordpress.username && wordpress.appPassword),\n      siteUrl: (wordpress && wordpress.siteUrl) || ''\n    }\n  }\n}];"
