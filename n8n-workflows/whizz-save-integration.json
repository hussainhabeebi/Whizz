      "name": "Read Integrations",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [460, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ── Stores whatever fields were submitted for a given integration (e.g. 'brevo', 'wordpress:<id>') ──\n// as a single JSON blob per service, so this workflow doesn't need to change when a new\n// integration is added — only the Integrations settings page + the workflow that reads it do.\n//\n// Merges with whatever was already saved for that service: a blank/omitted field in the\n// incoming request keeps its previous value instead of wiping it. This lets the frontend\n// leave a secret field (apiKey / appPassword) empty when editing without erasing it.\nconst incoming = $('Webhook').first().json.body || {};\nconst service = (incoming.service || '').toLowerCase();\nif (!service) {\n  throw new Error('Missing \"service\" field — expected e.g. \"brevo\" or \"wordpress:<id>\"');\n}\n\nconst rows = $input.all();\nconst existingRow = rows.find(r => (r.json.service || '').toLowerCase() === service);\nlet existing = {};\nif (existingRow) {\n  try { existing = JSON.parse(existingRow.json.data || '{}'); } catch (e) { existing = {}; }\n}\n\nconst merged = { ...existing };\nfor (const [key, value] of Object.entries(incoming)) {\n  if (value !== undefined && value !== null && value !== '') {\n    merged[key] = value;\n  }\n}\nmerged.service = service;\n\nreturn [{\n  json: {\n    service,\n    data: JSON.stringify(merged),\n    updatedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000002",
      "name": "Merge & Build Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
