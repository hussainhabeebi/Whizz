        "sheetName": {
          "__rl": true,
          "value": "Integrations",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "service": "={{ $json.service }}",
            "data": "={{ $json.data }}",
            "updatedAt": "={{ $json.updatedAt }}"
          },
          "matchingColumns": ["service"],
          "schema": []
        },
        "options": {}
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000003",
