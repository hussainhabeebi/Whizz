    {
      "parameters": {
        "jsCode": "// ── Look up the sheet row number for the given \"service\" key (e.g. \"wordpress:wp_abc123\") ──\n// Deleting by matching-column isn't supported for Google Sheets delete, so we resolve the\n// row number ourselves first.\nconst service = (($('Webhook').first().json.body || {}).service || '').toLowerCase();\nconst rows = $input.all();\nconst row = rows.find(r => (r.json.service || '').toLowerCase() === service);\n\nreturn [{\n  json: {\n    found: !!row,\n    rowNumber: row ? row.json.row_number : null\n  }\n}];"
      },
      "id": "b8c9d0e1-0008-0008-0008-000000000003",
      "name": "Find Row Number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b8c9d0e1-0008-0008-0008-000000000004",
      "name": "Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
