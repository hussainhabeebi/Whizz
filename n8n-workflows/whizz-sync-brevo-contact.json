    {
      "parameters": {
        "jsCode": "// ── Look up the stored Brevo config and build the exact Brevo API payload ──\n// Skips (never errors) when Brevo isn't connected yet, or the lead has no email —\n// Brevo's contact API requires an email as the primary identifier even for SMS-only contacts.\nconst rows = $input.all();\nconst lead = $('Webhook').first().json.body || {};\n\nconst row = rows.find(r => (r.json.service || '').toLowerCase() === 'brevo');\nlet cfg = {};\ntry { cfg = row ? JSON.parse(row.json.data || '{}') : {}; } catch (e) { cfg = {}; }\n\nconst skip = !cfg.apiKey || !lead.email;\nconst skipReason = !cfg.apiKey\n  ? 'Brevo is not connected yet'\n  : (!lead.email ? 'Lead has no email address — Brevo requires one' : '');\n\nconst attributes = {};\nif (lead.phone) attributes.SMS = lead.phone;\nif (lead.contactName) attributes.LASTNAME = lead.contactName;\n\nconst brevoPayload = {\n  email: lead.email || '',\n  attributes,\n  updateEnabled: true\n};\nif (cfg.listId) brevoPayload.listIds = [Number(cfg.listId)];\n\nreturn [{\n  json: {\n    apiKey: cfg.apiKey || '',\n    skip,\n    skipReason,\n    brevoPayload\n  }\n}];"
      },
      "id": "f6a7b8c9-0006-0006-0006-000000000003",
      "name": "Get Brevo Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f6a7b8c9-0006-0006-0006-000000000004",
      "name": "Skip Sync?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
