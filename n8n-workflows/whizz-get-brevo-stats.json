      "parameters": {
        "jsCode": "const rows = $input.all();\nconst row = rows.find(r => (r.json.service || '').toLowerCase() === 'brevo');\nlet cfg = {};\ntry { cfg = row ? JSON.parse(row.json.data || '{}') : {}; } catch (e) { cfg = {}; }\n\nreturn [{ json: { apiKey: cfg.apiKey || '', skip: !cfg.apiKey } }];"
      },
