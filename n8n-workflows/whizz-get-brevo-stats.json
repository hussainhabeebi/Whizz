      "id": "a7b8c9d0-0007-0007-0007-000000000005",
      "name": "Fetch Brevo Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "jsCode": "// ── Normalize Brevo's campaign list + globalStats into the shape the Reports page expects ──\nconst body = $input.first().json;\nconst campaigns = (body.campaigns || []).map(c => {\n  const stats = c.statistics && c.statistics.globalStats ? c.statistics.globalStats : {};\n  return {\n    name: c.name || c.subject || 'Untitled Campaign',\n    sentDate: c.sentDate || c.scheduledAt || null,\n    sent: stats.sent || 0,\n    delivered: stats.delivered || 0,\n    opens: stats.uniqueViews || stats.opens || 0,\n    clicks: stats.uniqueClicks || stats.clicks || 0,\n    bounces: (stats.softBounces || 0) + (stats.hardBounces || 0)\n  };\n});\n\nreturn [{ json: { campaigns } }];"
      },
      "id": "a7b8c9d0-0007-0007-0007-000000000006",
